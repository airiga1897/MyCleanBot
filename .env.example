DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mycleanbot.internal
CSRF_TRUSTED_ORIGINS=https://mycleanbot.internal
DATABASE_URL=postgresql://mycleanbot:password@postgres.internal:5432/mycleanbot
CACHE_URL=locmem://mycleanbot
DB_CONN_MAX_AGE=300
DASHBOARD_CACHE_TTL_SECONDS=15
DASHBOARD_POLL_SECONDS=15
ACTIVE_SCAN_POLL_SECONDS=5
MASTER_ENCRYPTION_KEY=replace-with-fernet-key
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=replace-with-api-hash
MINI_APP_RECONCILE_SECONDS=300
MINI_APP_DISCOVERY_SECONDS=21600
TELEGRAM_DIALOG_SYNC_SECONDS=300
HISTORY_SCAN_BATCH_SIZE=100
HISTORY_SCAN_YIELD_SECONDS=0.25
TZ=Europe/Moscow
